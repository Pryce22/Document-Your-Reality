{% endif %}

    {
      "known_id": "",
      "name": "grey storage bin",
      "distinctive": "grey plastic bin with a yellow bag and tools in it, on the floor by the desk",
      "x0": 386, "y0": 495, "x1": 823, "y1": 756,
      "title": "Storage bin",
      "body": "Open grey bin holding a yellow dry bag, a blue tool and loose hand tools.",
      "steps": [],
