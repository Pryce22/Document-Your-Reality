# Copy to .env and edit. The .env is per-machine and is not tracked.
# Precedence: process environment, then .env, then config.yaml.

# Model served by your OpenAI-compatible endpoint.
DYR_LLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# Required on a reasoning model: without it the whole token budget is spent
# thinking and the reply comes back empty. It is also what makes the
# constrained scan work, so leave it on for llm.scan_constrained.
DYR_LLM_DISABLE_THINKING=1

# To point somewhere else without touching config.yaml:
# DYR_LLM_BASE_URL=http://127.0.0.1:11434/v1
# DYR_LLM_API_KEY=your-key
